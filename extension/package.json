{
  "name": "isabelle-revamp",
  "displayName": "Isabelle Revamp",
  "description": "Unofficial Isabelle/HOL support for VS Code: live goals, Unicode symbols and an MCP server for AI agents, using your installed Isabelle.",
  "version": "0.2.0",
  "publisher": "hymanimy",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "isabelle",
    "isabelle/hol",
    "hol",
    "isar",
    "theorem prover",
    "proof assistant",
    "formal verification",
    "mcp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:isabelle",
    "onView:isabelleRevamp.goals",
    "onCommand:isabelleRevamp.showGoals",
    "onCommand:isabelleRevamp.setupCheck",
    "onView:isabelleRevamp.theories",
    "onCommand:isabelleRevamp.registerMcp"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run build",
    "build": "tsc -p . --noEmit && node build.cjs",
    "package": "vsce package",
    "test": "tsc -p . && node test/unit.cjs",
    "test:integration": "tsc -p . && node test/runIntegration.cjs"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "isabelleRevamp.goals",
          "name": "Isabelle Goals",
          "type": "webview"
        },
        {
          "id": "isabelleRevamp.theories",
          "name": "Isabelle Theories"
        }
      ]
    },
    "commands": [
      {
        "command": "isabelleRevamp.togglePrettySymbols",
        "title": "Isabelle: Toggle Pretty Symbols"
      },
      {
        "command": "isabelleRevamp.showGoals",
        "title": "Isabelle: Show Goals"
      },
      {
        "command": "isabelleRevamp.showTheories",
        "title": "Isabelle: Show Theories"
      },
      {
        "command": "isabelleRevamp.convertQuotes",
        "title": "Isabelle: Convert quotes to cartouches",
        "enablement": "editorLangId == isabelle"
      },
      {
        "command": "isabelleRevamp.setupCheck",
        "title": "Isabelle Revamp: Setup check"
      },
      {
        "command": "isabelleRevamp.registerMcp",
        "title": "Isabelle: Register MCP Server with Claude Code"
      }
    ],
    "languages": [
      {
        "id": "isabelle",
        "aliases": [
          "Isabelle",
          "Isar"
        ],
        "extensions": [
          ".thy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "isabelle",
        "scopeName": "source.isabelle",
        "path": "./syntaxes/isabelle.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[isabelle]": {
        "editor.tabCompletion": "on",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "on",
          "strings": "on"
        },
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Isabelle Revamp",
      "properties": {
        "isabelleRevamp.showAgentEdits": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Highlight MCP edits in editors that show the file, without scrolling or moving your caret: new text is highlighted for 2 seconds, with the agent's name for 3 seconds."
        },
        "isabelleRevamp.prettySymbols": {
          "type": "boolean",
          "default": true,
          "description": "Display ASCII Isabelle symbols as mathematics; reveal source at the cursor. Does not change the file or source coordinates.",
          "scope": "resource"
        },
        "isabelleRevamp.executable": {
          "type": "string",
          "default": "isabelle",
          "scope": "machine-overridable",
          "description": "Path to the Isabelle executable (~/ is supported), or isabelle on PATH. Reload the window after changing this setting."
        },
        "isabelleRevamp.logic": {
          "type": "string",
          "default": "HOL",
          "scope": "window",
          "description": "Logic session the prover starts from (isabelle vscode_server -l), e.g. HOL-Analysis. Its heap must be built: isabelle build -b <logic>. Reload the window after changing this setting."
        },
        "isabelleRevamp.sessionDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "description": "Extra session directories (isabelle vscode_server -d), e.g. ~/afp/thys. Relative paths resolve against the first workspace folder. Reload the window after changing this setting."
        },
        "isabelleRevamp.checkingPerspective": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "scope": "window",
          "description": "Like Isabelle/jEdit, check only the text near the cursor: this many lines above and below it, plus everything before. 0 checks every open theory in full, which is slower on large theories. Reload the window after changing this setting."
        },
        "isabelleRevamp.outputDelay": {
          "type": "number",
          "default": 0.2,
          "minimum": 0.05,
          "maximum": 2,
          "scope": "window",
          "description": "Seconds Isabelle waits for checking to go quiet before sending results (vscode_output_delay). Lower shows results sooner; higher sends less on very large theories. Isabelle's own default is 0.5, Isabelle/jEdit uses 0.1. Reload the window after changing this setting."
        },
        "isabelleRevamp.unicodeOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Save recognised Isabelle symbols as Unicode. Off by default: completions and saved source use ASCII Isabelle spellings."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "isabelle_free",
        "superType": "variable",
        "description": "Isabelle free variable (from PIDE)"
      },
      {
        "id": "isabelle_bound",
        "superType": "variable",
        "description": "Isabelle bound variable (from PIDE)"
      },
      {
        "id": "isabelle_skolem",
        "superType": "variable",
        "description": "Isabelle skolem variable (from PIDE)"
      },
      {
        "id": "isabelle_tfree",
        "superType": "typeParameter",
        "description": "Isabelle tfree variable (from PIDE)"
      },
      {
        "id": "isabelle_tvar",
        "superType": "typeParameter",
        "description": "Isabelle tvar variable (from PIDE)"
      },
      {
        "id": "isabelle_var",
        "superType": "variable",
        "description": "Isabelle var variable (from PIDE)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "isabelle",
        "scopes": {
          "isabelle_free": [
            "variable.other.free.isabelle"
          ],
          "isabelle_bound": [
            "variable.parameter.bound.isabelle"
          ],
          "isabelle_skolem": [
            "variable.other.constant.skolem.isabelle"
          ],
          "isabelle_tfree": [
            "entity.name.type.free.isabelle"
          ],
          "isabelle_tvar": [
            "entity.name.type.variable.isabelle"
          ],
          "isabelle_var": [
            "variable.other.isabelle"
          ]
        }
      }
    ],
    "colors": [
      {
        "id": "isabelle.unprocessedBackground",
        "description": "Background of Isabelle commands not yet checked (jEdit: unprocessed1_color).",
        "defaults": {
          "light": "#FFA0A032",
          "dark": "#A040A026",
          "highContrast": "#A040A026",
          "highContrastLight": "#FFA0A032"
        }
      },
      {
        "id": "isabelle.runningBackground",
        "description": "Background of Isabelle commands still running (jEdit: running1_color).",
        "defaults": {
          "light": "#61006164",
          "dark": "#B040B066",
          "highContrast": "#B040B066",
          "highContrastLight": "#61006164"
        }
      },
      {
        "id": "isabelle.canceledBackground",
        "description": "Background of Isabelle commands whose execution was canceled.",
        "defaults": {
          "light": "#FF6A6A64",
          "dark": "#FF6A6A40",
          "highContrast": "#FF6A6A40",
          "highContrastLight": "#FF6A6A64"
        }
      },
      {
        "id": "isabelle.badBackground",
        "description": "Background of failed or admitted (sorry) Isabelle text.",
        "defaults": {
          "light": "#FF6A6A64",
          "dark": "#FF6A6A40",
          "highContrast": "#FF6A6A40",
          "highContrastLight": "#FF6A6A64"
        }
      },
      {
        "id": "isabelle.intensifyBackground",
        "description": "Background of Isabelle text highlighted by the prover.",
        "defaults": {
          "light": "#FFCC6664",
          "dark": "#CC880033",
          "highContrast": "#CC880033",
          "highContrastLight": "#FFCC6664"
        }
      },
      {
        "id": "isabelle.unprocessedOverview",
        "description": "Scrollbar mark for Isabelle text not yet checked.",
        "defaults": {
          "light": "#FFA0A0FF",
          "dark": "#D89090FF",
          "highContrast": "#D89090FF",
          "highContrastLight": "#FFA0A0FF"
        }
      },
      {
        "id": "isabelle.runningOverview",
        "description": "Scrollbar mark for Isabelle commands still running.",
        "defaults": {
          "light": "#610061FF",
          "dark": "#C060C0FF",
          "highContrast": "#C060C0FF",
          "highContrastLight": "#610061FF"
        }
      },
      {
        "id": "isabelle.writelnUnderline",
        "description": "Dotted underline of Isabelle text with output messages.",
        "defaults": {
          "light": "#C0C0C0FF",
          "dark": "#9C9C9CFF",
          "highContrast": "#9C9C9CFF",
          "highContrastLight": "#C0C0C0FF"
        }
      },
      {
        "id": "isabelle.informationUnderline",
        "description": "Dotted underline of Isabelle text with information messages.",
        "defaults": {
          "light": "#C1DFEEFF",
          "dark": "#77B800FF",
          "highContrast": "#77B800FF",
          "highContrastLight": "#C1DFEEFF"
        }
      },
      {
        "id": "isabelle.warningUnderline",
        "description": "Dotted underline of Isabelle text with warnings.",
        "defaults": {
          "light": "#FF8C00FF",
          "dark": "#FF8C00FF",
          "highContrast": "#FF8C00FF",
          "highContrastLight": "#FF8C00FF"
        }
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "vscode-languageclient": "10.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hymanimy/isabelle-revamp.git"
  },
  "homepage": "https://github.com/hymanimy/isabelle-revamp#readme",
  "bugs": {
    "url": "https://github.com/hymanimy/isabelle-revamp/issues"
  },
  "vsce": {
    "dependencies": false,
    "packagePath": "../dist"
  }
}
