{
  "name": "isabelle-revamp",
  "displayName": "Isabelle Revamp",
  "description": "Isabelle/HOL in stock VS Code using the installed Isabelle language server.",
  "version": "0.1.0",
  "publisher": "hymanimy",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:isabelle",
    "onView:isabelleRevamp.goals",
    "onView:isabelleRevamp.swarm",
    "onCommand:isabelleRevamp.ask",
    "onCommand:isabelleRevamp.showGoals",
    "onCommand:isabelleRevamp.showSwarm",
    "onCommand:isabelleRevamp.setupCheck",
    "onCommand:isabelleRevamp.showProofGraph",
    "onView:isabelleRevamp.ask",
    "onCommand:isabelleRevamp.demoLayout",
    "onView:isabelleRevamp.proofGraph"
  ],
  "scripts": {
    "compile": "tsc -p . && node build-webview.cjs",
    "vscode:prepublish": "npm run build",
    "build": "tsc -p . --noEmit && node build.cjs",
    "package": "vsce package"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "isabelleRevamp.goals",
          "name": "Isabelle Goals",
          "type": "webview"
        },
        {
          "id": "isabelleRevamp.swarm",
          "name": "Isabelle Swarm",
          "type": "webview"
        }
      ],
      "isabelle-revamp-ask": [
        {
          "id": "isabelleRevamp.ask",
          "name": "Ask Isabelle",
          "type": "webview"
        },
        {
          "id": "isabelleRevamp.proofGraph",
          "name": "Proof Graph",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "isabelleRevamp.togglePrettySymbols",
        "title": "Isabelle: Toggle Pretty Symbols"
      },
      {
        "command": "isabelleRevamp.ask",
        "title": "Isabelle: Ask"
      },
      {
        "command": "isabelleRevamp.showGoals",
        "title": "Isabelle: Show Goals"
      },
      {
        "command": "isabelleRevamp.showSwarm",
        "title": "Isabelle: Show Swarm"
      },
      {
        "command": "isabelleRevamp.convertQuotes",
        "title": "Isabelle: Convert quotes to cartouches",
        "enablement": "editorLangId == isabelle"
      },
      {
        "command": "isabelleRevamp.setupCheck",
        "title": "Isabelle Revamp: Setup check"
      },
      {
        "command": "isabelleRevamp.showProofGraph",
        "title": "Isabelle: Show Proof Graph"
      },
      {
        "command": "isabelleRevamp.demoLayout",
        "title": "Isabelle: Demo Layout"
      }
    ],
    "languages": [
      {
        "id": "isabelle",
        "aliases": [
          "Isabelle",
          "Isar"
        ],
        "extensions": [
          ".thy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "isabelle",
        "scopeName": "source.isabelle",
        "path": "./syntaxes/isabelle.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[isabelle]": {
        "editor.tabCompletion": "on",
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "on",
          "strings": "on"
        },
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Isabelle Revamp",
      "properties": {
        "isabelleRevamp.prettySymbols": {
          "type": "boolean",
          "default": true,
          "description": "Display ASCII Isabelle symbols as mathematics; reveal source at the cursor. Does not change the file or source coordinates.",
          "scope": "resource"
        },
        "isabelleRevamp.executable": {
          "type": "string",
          "default": "isabelle",
          "scope": "machine-overridable",
          "description": "Path to the Isabelle executable (~/ is supported), or isabelle on PATH. Reload the window after changing this setting."
        },
        "isabelleRevamp.unicodeOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Save recognised Isabelle symbols as Unicode. Off by default: completions and saved source use ASCII Isabelle spellings."
        },
        "isabelleRevamp.demoShowGoals": {
          "type": "boolean",
          "default": false,
          "description": "Also show the Goals sidebar in Demo Layout. Off leaves more space for the proof graph.",
          "scope": "window"
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "isabelle_free",
        "superType": "variable",
        "description": "Isabelle free variable (from PIDE)"
      },
      {
        "id": "isabelle_bound",
        "superType": "variable",
        "description": "Isabelle bound variable (from PIDE)"
      },
      {
        "id": "isabelle_skolem",
        "superType": "variable",
        "description": "Isabelle skolem variable (from PIDE)"
      },
      {
        "id": "isabelle_tfree",
        "superType": "typeParameter",
        "description": "Isabelle tfree variable (from PIDE)"
      },
      {
        "id": "isabelle_tvar",
        "superType": "typeParameter",
        "description": "Isabelle tvar variable (from PIDE)"
      },
      {
        "id": "isabelle_var",
        "superType": "variable",
        "description": "Isabelle var variable (from PIDE)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "isabelle",
        "scopes": {
          "isabelle_free": [
            "variable.other.free.isabelle"
          ],
          "isabelle_bound": [
            "variable.parameter.bound.isabelle"
          ],
          "isabelle_skolem": [
            "variable.other.constant.skolem.isabelle"
          ],
          "isabelle_tfree": [
            "entity.name.type.free.isabelle"
          ],
          "isabelle_tvar": [
            "entity.name.type.variable.isabelle"
          ],
          "isabelle_var": [
            "variable.other.isabelle"
          ]
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "isabelle-revamp-ask",
          "title": "Isabelle",
          "icon": "media/ask.svg"
        }
      ]
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hymanimy/isabelle-revamp.git"
  },
  "vsce": {
    "dependencies": false,
    "packagePath": "../dist"
  }
}
