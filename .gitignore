extension/node_modules/
extension/out/
.dev-host/
__pycache__/
mcp/.venv/
dist/
# Build-time copies of mcp/; git cannot re-include a file under an excluded
# directory, so this must exclude the contents rather than the directory.
extension/mcp/*
!extension/mcp/README.md
extension/LICENSE
mcp/.setup-lock/
extension/media/proofGraph.js
# Expanded from the committed demo/.mcp.json.template by scripts/demo-env.sh.
demo/.demo/
demo/.mcp.json

# Headless evaluation: keep reports, omit private traces and temporary theories.
eval/.venv/
eval/results/**
!eval/results/**/
!eval/results/**/summary.md
!eval/results/**/EVAL_RESULTS.md
.pytest_cache/
